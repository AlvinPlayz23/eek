{
  "name": "personal-assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --import ./src/instrument.ts src/local.ts",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest --no-discovery",
    "build": "tsc && pnpm --filter web build",
    "dev:web": "pnpm --filter web dev",
    "start": "node --import ./dist/src/instrument.js dist/src/local.js",
    "test": "tsx --test --experimental-test-module-mocks \"src/**/*.test.ts\"",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:push": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs push",
    "telegram:commands": "tsx --env-file=.env scripts/set-telegram-commands.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.86",
    "@daytona/sdk": "^0.227.0",
    "@hono/node-server": "^2.1.3",
    "@linqapp/sdk": "^0.78.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@sentry/node": "^11.11.0",
    "ai": "^7.0.164",
    "drizzle-orm": "^0.45.4",
    "firecrawl-aisdk": "^0.13.1",
    "hono": "^4.13.14",
    "inngest": "^4.26.2",
    "pg": "^8.23.1",
    "rrule": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.8",
    "@inngest/test": "^1.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "inngest-cli": "^1.51.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
