# Copy to .env for local development (`npm run dev`, `npm run inngest:dev`, `npm run db:push`).
# On Vercel, set these in the project's environment variables instead.

# --- Database (Neon Postgres) ---
# Pooled connection, used by the app and the Inngest functions
DATABASE_URL=
# Direct connection, used only by `npm run db:push` / `db:studio`
DATABASE_URL_UNPOOLED=

# --- Inngest ---
# Local development: use the Inngest dev server (`npm run inngest:dev`)
INNGEST_DEV=1
# Production: set by Inngest's Vercel integration. Don't set INNGEST_DEV there, and never copy
# these between environments
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- AI model (Neon AI Gateway) ---
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Also passed as `secret_token` to Telegram's setWebhook
TELEGRAM_WEBHOOK_SECRET=

# --- Linq (iMessage) ---
LINQ_API_V3_API_KEY=
# Standard Webhooks signing secret of the Linq webhook subscription
LINQ_WEBHOOK_SECRET=

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Confidential OAuth app with the Device Authorization Grant enabled (used to link chat accounts)
CLERK_OAUTH_ISSUER=
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=

# --- Tools ---
# The agent's Linux computer
DAYTONA_API_KEY=
# Live web access
FIRECRAWL_API_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
# Defaults to VERCEL_ENV, then NODE_ENV
# SENTRY_ENVIRONMENT=
# Defaults to VERCEL_GIT_COMMIT_SHA
# SENTRY_RELEASE=

# --- Local server (optional) ---
# PORT=3000
