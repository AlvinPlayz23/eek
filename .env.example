# Copy to .env for local development (`pnpm run dev`, `pnpm run inngest:dev`, `pnpm run db:push`).
# On Vercel, set these in the project's environment variables instead.

# --- Database (Neon Postgres) ---
# Pooled connection, used by the app and the Inngest functions
DATABASE_URL=
# Direct connection, used only by `pnpm run db:push` / `db:studio`
DATABASE_URL_UNPOOLED=

# --- Inngest ---
# Local development: use the Inngest dev server (`pnpm run inngest:dev`)
INNGEST_DEV=1
# Production: set by Inngest's Vercel integration. Don't set INNGEST_DEV there, and never copy
# these between environments
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- AI model (any OpenAI-compatible API) ---
# Base URL of the API, including the version path, e.g. https://api.openai.com/v1
OPENAI_BASEURL=
# Model id to use. It must support tool calling, and image input for screenshots and photos
OPENAI_MODEL=
OPENAI_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Also passed as `secret_token` to Telegram's setWebhook
TELEGRAM_WEBHOOK_SECRET=

# --- Linq (iMessage): switched off. Set LINQ_ENABLED=true and the two keys to turn it on (docs/linq.md) ---
# LINQ_ENABLED=true
# LINQ_API_V3_API_KEY=
# Standard Webhooks signing secret of the Linq webhook subscription
# LINQ_WEBHOOK_SECRET=

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Confidential OAuth app with the Device Authorization Grant enabled (used to link chat accounts)
CLERK_OAUTH_ISSUER=
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=

# --- Tools ---
# The agent's Linux computer
DAYTONA_API_KEY=
# Live web access
FIRECRAWL_API_KEY=

# --- Gmail (via Composio, managed OAuth) ---
# No Google Cloud project needed - Composio hosts the Google OAuth consent and stores tokens
COMPOSIO_API_KEY=
# Optional: reuse an existing Composio auth config id for Gmail. If unset the app creates/finds one
COMPOSIO_AUTH_CONFIG_ID=

# --- Observability (optional) ---
SENTRY_DSN=
# Defaults to VERCEL_ENV, then NODE_ENV
# SENTRY_ENVIRONMENT=
# Defaults to VERCEL_GIT_COMMIT_SHA
# SENTRY_RELEASE=

# --- Local server (optional) ---
# PORT=3000
